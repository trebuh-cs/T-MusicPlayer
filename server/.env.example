# Server HTTP port (point your Cloudflare Tunnel service to http://localhost:8484)
PORT=8484

# Directory for hosted Android APK / Windows EXE client downloads (served at /downloads)
DOWNLOADS_DIR=/app/downloads

# Optional: leave blank to auto-generate and persist a random secret in DATA_DIR/.jwt_secret
JWT_SECRET=

# Optional initial admin user created automatically on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Multi-user registration settings
ALLOW_REGISTRATION=true
# Optional invite code friends must enter when registering (leave blank for open registration)
INVITE_CODE=
