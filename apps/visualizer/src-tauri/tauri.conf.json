{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T - Visualizer",
  "version": "0.1.0",
  "identifier": "dev.trebuh.tvisualizer",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "T - Visualizer",
        "width": 1160,
        "height": 740,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
